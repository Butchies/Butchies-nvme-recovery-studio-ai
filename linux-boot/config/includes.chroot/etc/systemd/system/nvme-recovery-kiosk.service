[Unit]
Description=NVMe Recovery Studio AI (Vollbild-Kiosk)
After=mnt-nvmedaten.mount systemd-user-sessions.service plymouth-quit-wait.service nvme-recovery-persistence.service NetworkManager.service
Wants=NetworkManager.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_RUNTIME_DIR=/run/nvme-recovery
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_QUICK_CONTROLS_STYLE=Fusion
RuntimeDirectory=nvme-recovery
RuntimeDirectoryMode=0700
# cage zeigt ausschließlich die Anwendung; beim Beenden startet sie neu.
ExecStart=/usr/bin/cage -s -- /opt/nvme-recovery-studio/bin/nvme-recovery-studio
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
