[Unit]
Description=NVMe Recovery Studio AI (Vollbild-Kiosk)
After=systemd-user-sessions.service systemd-logind.service
Wants=systemd-logind.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_RUNTIME_DIR=/run/nvme-recovery
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_QUICK_CONTROLS_STYLE=Fusion
RuntimeDirectory=nvme-recovery
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/test -x /opt/nvme-recovery-studio/bin/nvme-recovery-studio
ExecStart=/usr/bin/cage -s -- /opt/nvme-recovery-studio/bin/nvme-recovery-studio
Restart=always
RestartSec=3
StartLimitIntervalSec=0

[Install]
WantedBy=graphical.target
